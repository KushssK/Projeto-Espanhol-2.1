DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco"
JWT_SECRET="altere-para-uma-chave-segura"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
BOOTSTRAP_SECRET="altere-para-uma-chave-segura"
NODE_ENV=development

# Supabase Storage (apenas PRODUÇÃO) — uploads persistentes no bucket público
# Sem essas variáveis, o backend usa o fallback local /uploads (desenvolvimento).
# Crie o bucket (ex.: "uploads") como público no painel do Supabase e use a
# Service Role Key (nunca a anon key) em SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_URL="https://SEU-PROJETO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service_role_secret"
SUPABASE_BUCKET="uploads"