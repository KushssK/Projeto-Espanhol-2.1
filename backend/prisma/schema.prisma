generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// 1. USUÁRIOS E AUTENTICAÇÃO
// ============================================================================

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  username            String?   @unique
  passwordHash        String?   // Hash bcrypt da senha (segunda credencial de login)
  accessCodeHash      String?   // Hash bcrypt do código de acesso (6 caracteres)
  dob                 DateTime  // Data de nascimento
  role                Role      @default(STUDENT)
  avatarUrl           String?
  isBanned            Boolean   @default(false)
  failedLoginAttempts Int       @default(0) // Tentativas de login falhas (anti brute force)
  lockoutUntil        DateTime? // Bloqueio temporário após tentativas em excesso
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relacionamentos
  progress            UserProgress[]
  roomMembers         RoomMember[]
  messages            Message[]
}

// Whitelist de e-mails — quem está aqui recebe a role automaticamente ao cadastrar
model WhitelistEmail {
  email String @id // PK: e-mail normalizado (lowercase + trim)
  role  Role   // Role automática ao cadastrar
}

// ============================================================================
// 2. CMS DINÂMICO (IDENTIDADE VISUAL DA PLATAFORMA)
// ============================================================================

model AppSettings {
  id         Int      @id @default(1)
  themeColor String   @default("#7C3AED") // Cor principal para consumo dinâmico do front
  logoUrl    String?
  updatedAt  DateTime @updatedAt
}

// ============================================================================
// 3. CONTEÚDO CURRICULAR E ORDENAÇÃO
// ============================================================================

model Module {
  id          String   @id @default(uuid())
  title       String   // Ex: "Conversação", "Vocabulário"
  description String?
  orderIndex  Int      @default(0) // Permitirá ordenação customizada (Drag-and-Drop)
  
  categories   Category[]
  lessons      Lesson[]
  mediaItems   MediaLibrary[]
}

model Category {
  id          String   @id @default(uuid())
  moduleId    String
  title       String
  description String?
  orderIndex  Int      @default(0)

  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
}

model Lesson {
  id          String    @id @default(uuid())
  moduleId    String
  categoryId  String?
  title       String
  content     String    @db.Text
  videoUrl    String?   // Link de plataforma terceira (YouTube, Vimeo)
  published   Boolean   @default(false) // Se true, a aula fica visível para alunos
  orderIndex  Int       @default(0)
  deletedAt   DateTime? // Soft delete — aula excluída mas recuperável
  
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attachments Attachment[]
  progress    UserProgress[]
}

model MediaLibrary {
  id          String    @id @default(uuid())
  moduleId    String?
  title       String
  description String?   @db.Text
  type        MediaType
  url         String?   // Arquivo local em /uploads/media
  videoUrl    String?   // YouTube/Vimeo
  orderIndex  Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  module      Module?   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
}

enum MediaType {
  PDF
  AUDIO
  IMAGE
}

model Attachment {
  id         String    @id @default(uuid())
  lessonId   String
  type       MediaType
  url        String    // Caminho relativo no storage do servidor local
  orderIndex Int       @default(0)

  lesson     Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 4. PROGRESSO E EXPERIÊNCIA GAMIFICADA
// ============================================================================

model UserProgress {
  userId      String
  lessonId    String
  isCompleted Boolean  @default(false)
  score       Int      @default(0) // Sistema de pontuação inspirado no Duolingo
  completedAt DateTime?

  user        User     @relation(fields: [userId], references: [id])
  lesson      Lesson   @relation(fields: [lessonId], references: [id])

  @@id([userId, lessonId])
}

// ============================================================================
// 5. CHAT COMUNITÁRIO (TANDEM-LIKE)
// ============================================================================

enum RoomType {
  PRIVATE
  GROUP
}

model ChatRoom {
  id        String   @id @default(uuid())
  type      RoomType
  name      String?  // Relevante apenas para grupos comunitários
  createdAt DateTime @default(now())

  members   RoomMember[]
  messages  Message[]
}

model RoomMember {
  userId     String
  chatRoomId String
  joinedAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id])
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id])

  @@id([userId, chatRoomId]) // Chave composta
}

model Message {
  id         String    @id @default(uuid())
  chatRoomId String
  senderId   String
  content    String?   @db.Text
  mediaUrl   String?   // Limite 20MB
  mediaType  MediaType?
  createdAt  DateTime  @default(now())

  room       ChatRoom  @relation(fields: [chatRoomId], references: [id])
  sender     User      @relation(fields: [senderId], references: [id])
}
