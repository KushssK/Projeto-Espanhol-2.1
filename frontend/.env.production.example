# Copie para .env.production ANTES de rodar `npm run build`
# Sem estas variáveis, o bundle embute localhost:3000 e o app quebra em produção.

# URL da API (backend Node no Render)
VITE_API_URL="https://construindo-saberes.onrender.com/api"

# URL do Socket.IO (mesmo host da API, sem o /api)
VITE_SOCKET_URL="https://construindo-saberes.onrender.com"
