# ══════════════════════════════════════════════════════════════
# Construindo Saberes — Variáveis de Ambiente
# Copie para .env e preencha os valores
# ══════════════════════════════════════════════════════════════

# Servidor
PORT=3100
NODE_ENV=development

# ── SMTP (envio de código de acesso por e-mail) ──
# Opção 1: Gmail (até 500 e-mails/dia)
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=seu-email@gmail.com
#   SMTP_PASS=sua-senha-de-app
#   SMTP_FROM="Construindo Saberes <seu-email@gmail.com>"
#
# Opção 2: Resend (100 e-mails/dia grátis)
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=resend
#   SMTP_PASS=re_sua_chave_aqui
#   SMTP_FROM="Construindo Saberes <no-reply@seu-dominio.com>"
#
# Opção 3: Brevo (300 e-mails/dia grátis)
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=seu-email@brevo.com
#   SMTP_PASS=sua-chave-brevo
#   SMTP_FROM="Construindo Saberes <seu-email@gmail.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Construindo Saberes <no-reply@construindosaberes.com>"
